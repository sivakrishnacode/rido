# Copy to .env (used by docker compose). Never commit real secrets.
POSTGRES_USER=rido
POSTGRES_PASSWORD=rido
POSTGRES_DB=rido
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
NODE_ENV=production
# At least 32 characters in production: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRES_IN=30d
# true = any 6-digit OTP except 000000 works (demo); false = real codes (plug in an SMS provider)
OTP_DEV_MODE=true
CORS_ORIGINS=*
SEED_ON_START=true

# Google Maps Platform server key (Places API (New), Geocoding API, Routes API). Leave empty to use local data.
GOOGLE_MAPS_API_KEY=

# Phones that sign in to the admin panel as ADMIN (comma-separated, 10 digits or +91…)
ADMIN_PHONES=9000000001

# Admin panel (apps/admin, Next.js) host port
ADMIN_PORT=3001
# true once the admin panel is served over HTTPS (session cookie gets the Secure flag)
ADMIN_COOKIE_SECURE=false
# Browser key for the Google Maps JavaScript API used by the admin maps (baked in at build time)
GOOGLE_MAPS_BROWSER_KEY=

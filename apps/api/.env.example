# Local development (npm run start:dev -w @rido/api) against `docker compose up -d postgres redis`.
DATABASE_URL="postgresql://rido:rido@localhost:5432/rido?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-change-me"
PORT=3000
OTP_DEV_MODE=true

# Google Maps Platform server key (Places API (New), Geocoding API, Routes API). Leave empty to use local data.
GOOGLE_MAPS_API_KEY=

# Phones that sign in to the admin panel as ADMIN (comma-separated, 10 digits or +91…)
ADMIN_PHONES=9000000001

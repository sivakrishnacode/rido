// Rido database schema (PostgreSQL). Money is stored in whole rupees (Int), matching the fare engine.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  PREFER_NOT_TO_SAY
}

enum WorkType {
  RIDES
  DELIVERIES
}

enum VehicleKind {
  BIKE
  AUTO
  CAB
  GOODS_BIKE
  THREE_WHEELER
  MINI_TRUCK
  PICKUP
  TRUCK
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  ON_HOLD
}

enum KycDocType {
  DRIVING_LICENCE
  AADHAAR
  VEHICLE_RC
  INSURANCE
  POLICE_VERIFICATION
}

enum KycStatus {
  NOT_UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

/// Selfie + ID check with Didit (drivers: required; riders: optional "Verified" badge).
enum IdentityStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DECLINED
}

enum IdentityPurpose {
  DRIVER
  RIDER
}

enum TripKind {
  RIDE
  PARCEL
}

enum TripStatus {
  SEARCHING
  NO_DRIVERS
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  IN_PROGRESS
  PICKED_UP
  COMPLETED
  DELIVERED
  CANCELLED
}

/// Who ended (or gave up on) a trip.
enum CancelledBy {
  PASSENGER
  DRIVER
  SYSTEM
  ADMIN
}

/// Why a trip was cancelled. Passenger: CHANGED_MIND, DRIVER_TOO_FAR, DRIVER_ASKED_TO_CANCEL, WAIT_TOO_LONG,
/// BOOKED_BY_MISTAKE. Driver: PASSENGER_NO_SHOW (only after the wait, see noShowWaitMin), PASSENGER_UNREACHABLE,
/// PASSENGER_ASKED_TO_CANCEL, VEHICLE_ISSUE, TOO_FAR, BUTTERFLY_MISMATCH (Butterfly rider is not a woman). System:
/// NO_DRIVERS, DRIVER_NOT_MOVING, STUCK. OTHER for anyone. See trips/cancel-codes.ts.
enum CancelCode {
  CHANGED_MIND
  DRIVER_TOO_FAR
  DRIVER_ASKED_TO_CANCEL
  WAIT_TOO_LONG
  BOOKED_BY_MISTAKE
  PASSENGER_NO_SHOW
  PASSENGER_UNREACHABLE
  PASSENGER_ASKED_TO_CANCEL
  VEHICLE_ISSUE
  TOO_FAR
  BUTTERFLY_MISMATCH
  NO_DRIVERS
  DRIVER_NOT_MOVING
  STUCK
  OTHER
}

enum PaymentMode {
  CASH
  UPI
}

enum ParcelPayer {
  SENDER
  RECEIVER
}

/// Butterfly (women riders only): NONE = any driver, PREFERRED = women drivers first, ONLY = women drivers only.
enum WomenDriverPref {
  NONE
  PREFERRED
  ONLY
}

enum PlanPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ZoneKind {
  /// Higher demand: shown to drivers as "High demand" and can carry a surge multiplier.
  SURGE
  /// Informational demand hotspot (no price change).
  DEMAND
  /// No pickups or drops allowed (e.g. restricted areas).
  NO_SERVICE
  /// Airport / railway station style pickup points with their own rules.
  PICKUP_POINT
}

enum AnnouncementAudience {
  ALL
  PASSENGER
  DRIVER
}

enum AppKind {
  PASSENGER
  DRIVER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id                 String                 @id @default(cuid())
  phone              String                 @unique
  name               String?
  email              String?
  gender             Gender?
  role               Role                   @default(PASSENGER)
  preferWomenDriver  Boolean                @default(false)
  autoShareTrips     Boolean                @default(true)
  isBlocked          Boolean                @default(false)
  blockedReason      String?
  /// Latest Didit identity check result (mirrors the newest IdentityVerification).
  identityStatus     IdentityStatus         @default(NOT_STARTED)
  identityVerifiedAt DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  driver             Driver?
  emergencyContacts  EmergencyContact[]
  savedPlaces        SavedPlace[]
  trips              Trip[]                 @relation("PassengerTrips")
  tickets            SupportTicket[]
  devices            DeviceToken[]
  identityChecks     IdentityVerification[]
}

/// One Didit verification session. Only the last 4 digits of the document number are kept.
model IdentityVerification {
  id             String          @id @default(cuid())
  userId         String
  purpose        IdentityPurpose
  sessionId      String          @unique
  status         IdentityStatus  @default(NOT_STARTED)
  /// Didit's exact status string ("Approved", "In Review", "Kyc Expired", …).
  providerStatus String          @default("Not Started")
  documentType   String?
  documentLast4  String?
  /// Every scanned ID as [{type, last4}] (drivers: licence + Aadhaar).
  documents      Json?
  fullName       String?
  dateOfBirth    String?
  warnings       Json?
  /// What the user must fix (declined steps, plain words); shown in the apps.
  reasons        Json?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model EmergencyContact {
  id       String @id @default(cuid())
  userId   String
  name     String
  relation String
  phone    String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPlace {
  id      String  @id @default(cuid())
  userId  String
  label   String
  kind    String  @default("other") // home | work | other
  name    String
  address String
  lat     Float
  lng     Float
  note    String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Known places for search and reverse geocoding (seeded with Coimbatore landmarks).
model Place {
  id      String @id
  name    String
  address String
  lat     Float
  lng     Float

  @@index([name])
}

model Driver {
  id                String             @id @default(cuid())
  userId            String             @unique
  workType          WorkType           @default(RIDES)
  vehicleKind       VehicleKind
  vehicleModel      String
  vehicleColor      String             @default("")
  plate             String             @unique
  upiId             String
  /// Average of passengers' ratings (ratingSum / ratingCount, 2 decimals); 5 until the first rating.
  rating            Float              @default(5)
  ratingSum         Int                @default(0)
  ratingCount       Int                @default(0)
  ridesCount        Int                @default(0)
  status            DriverStatus       @default(PENDING)
  /// Profile photo riders see on their trip (taken in the app, matched to [selfieFile]). Private storage file.
  photoFile         String?
  photoUpdatedAt    DateTime?
  /// The live selfie from the approved Didit check: the reference a new profile photo is matched against.
  selfieFile        String?
  /// A new photo whose face match was unclear, waiting for an admin (Didit unreachable, or a low score).
  pendingPhotoFile  String?
  /// Face-match score (0–100) of the last photo checked.
  photoMatchScore   Float?
  /// Why an admin rejected the last photo.
  photoRejectReason String?
  isOnline          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         KycDocument[]
  trips             Trip[]
  cancellations     TripCancellation[]
  subscriptions     Subscription[]
}

model KycDocument {
  id           String     @id @default(cuid())
  driverId     String
  type         KycDocType
  status       KycStatus  @default(NOT_UPLOADED)
  rejectReason String?
  fileUrl      String?
  updatedAt    DateTime   @updatedAt
  driver       Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
}

model Trip {
  id               String             @id @default(cuid())
  kind             TripKind
  status           TripStatus         @default(SEARCHING)
  passengerId      String
  driverId         String?
  vehicleKind      VehicleKind
  pickupName       String
  pickupAddr       String
  pickupLat        Float
  pickupLng        Float
  dropName         String
  dropAddr         String
  dropLat          Float
  dropLng          Float
  /// H3 cells (res 8) of pickup and drop, for heatmaps and demand stats.
  pickupCell       String?
  dropCell         String?
  distanceKm       Float
  durationMin      Int
  /// Itemised quote: base, distance, time, topUp, subtotal, multiplier, peak, total.
  fare             Json
  fareTotal        Int
  /// "Book any" (like Namma Yatra): other vehicles the passenger added while searching, and their quotes by kind.
  /// The first driver of any of them to accept takes the trip at that vehicle's fare.
  alsoKinds        VehicleKind[]      @default([])
  alsoFares        Json?
  otp              String
  paymentMode      PaymentMode        @default(CASH)
  /// Parcel only: category, weight band, sender/receiver details.
  parcel           Json?
  payer            ParcelPayer?
  /// Butterfly: offer the trip to women drivers first (PREFERRED) or only (ONLY).
  womenDriver      WomenDriverPref    @default(NONE)
  /// "Who's riding?": booked for someone else (e.g. a father for his daughter). The driver sees and calls the rider.
  riderName        String?
  riderPhone       String?
  /// The rider (account holder, or [riderName]) is a woman: allows Butterfly.
  riderIsWoman     Boolean            @default(false)
  rating           Int?
  /// Free-text note with a cancel (older clients sent only this).
  cancelReason     String?
  /// Who cancelled, why (code) and when. Also set by the system on NO_DRIVERS.
  cancelledBy      CancelledBy?
  cancelCode       CancelCode?
  cancelledAt      DateTime?
  /// Times a driver dropped this trip and it went back to searching (capped by the `maxReassigns` setting).
  reassignCount    Int                @default(0)
  /// Driver's distance from the pickup when marking "Arrived", and the reason given when outside `arrivalRadiusM`.
  arrivedDistanceM Int?
  arrivedFarReason String?
  /// Distance from the drop when the trip was completed, and the reason when outside `dropRadiusM`.
  endDistanceM     Int?
  endFarReason     String?
  createdAt        DateTime           @default(now())
  assignedAt       DateTime?
  /// When the driver marked "Arrived" (starts the passenger no-show wait).
  arrivedAt        DateTime?
  /// arrivedAt + `noShowWaitMin`: from then the driver may cancel as PASSENGER_NO_SHOW (not held against them).
  noShowAt         DateTime?
  /// Straight-line metres from the driver to the pickup when they accepted (the "not moving" check compares to it).
  acceptDistanceM  Int?
  /// Flagged for an admin, e.g. a trip still running long after it should have ended ([reviewNote] says why).
  needsReview      Boolean            @default(false)
  reviewNote       String?
  startedAt        DateTime?
  endedAt          DateTime?
  passenger        User               @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver           Driver?            @relation(fields: [driverId], references: [id])
  tickets          SupportTicket[]
  cancellations    TripCancellation[]

  @@index([passengerId, createdAt])
  @@index([driverId, createdAt])
  @@index([status])
  @@index([needsReview])
  @@index([pickupCell])
  @@index([dropCell])
}

/// Every cancel of a trip, including a driver's cancel that sent the trip back to searching (the trip row keeps only
/// the last). Counts cancellation rates per driver / passenger: [isDriverFault] marks the ones held against the driver
/// (not a no-show after the wait, not a Butterfly mismatch).
model TripCancellation {
  id            String      @id @default(cuid())
  tripId        String
  /// The driver the trip had when it was cancelled (null while searching).
  driverId      String?
  passengerId   String
  by            CancelledBy
  code          CancelCode
  note          String?
  /// Trip status when it was cancelled (DRIVER_ASSIGNED, DRIVER_ARRIVED, …).
  fromStatus    TripStatus
  /// The trip went back to searching for another driver instead of ending.
  reassigned    Boolean     @default(false)
  isDriverFault Boolean     @default(false)
  createdAt     DateTime    @default(now())
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver        Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([driverId, createdAt])
  @@index([passengerId, createdAt])
}

/// Price list: one row per vehicle and period (daily / weekly / monthly).
model Plan {
  id            String         @id @default(cuid())
  vehicleKind   VehicleKind
  period        PlanPeriod
  price         Int
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@unique([vehicleKind, period])
}

model Subscription {
  id        String             @id @default(cuid())
  driverId  String
  planId    String
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  upiApp    String?
  autopay   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  driver    Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  payments  Payment[]

  @@index([driverId, status])
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Int
  status         PaymentStatus @default(PENDING)
  provider       String        @default("upi-autopay")
  providerRef    String?
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String
  tripId      String?
  topic       String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip?        @relation(fields: [tripId], references: [id])

  @@index([userId])
}

/// A city Rido operates in. The service area is a set of H3 cells at [h3Resolution].
model City {
  id           String         @id // slug, e.g. "coimbatore"
  name         String
  state        String
  centerLat    Float
  centerLng    Float
  h3Resolution Int            @default(8)
  /// H3 cell indexes (strings) that make up the service area.
  serviceCells String[]
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  zones        Zone[]
  fareRules    CityFareRule[]
}

/// A named group of H3 cells inside a city (surge, demand hotspot, no-service, pickup point).
model Zone {
  id              String   @id @default(cuid())
  cityId          String
  name            String
  kind            ZoneKind
  cells           String[]
  /// Fare multiplier for SURGE zones (1.0–1.5).
  surgeMultiplier Float    @default(1)
  color           String   @default("#F4511E")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
}

/// Per-city fare rates (fallback: built-in rates in fare-rules.ts).
model CityFareRule {
  id          String      @id @default(cuid())
  cityId      String
  vehicleKind VehicleKind
  base        Int
  perKm       Float
  perMin      Float
  minFare     Int
  isActive    Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  city        City        @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, vehicleKind])
}

/// Every admin change (who, what, when).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // e.g. "PATCH /admin/drivers/:id"
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// In-app notices for passengers and/or drivers.
model Announcement {
  id        String               @id @default(cuid())
  audience  AnnouncementAudience @default(ALL)
  title     String
  body      String
  cityId    String?
  isActive  Boolean              @default(true)
  startsAt  DateTime             @default(now())
  endsAt    DateTime?
  createdAt DateTime             @default(now())
}

/// Key-value platform settings (e.g. currentMultiplier, searchRadiusKm, offerSeconds).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Historical travel speed between two H3 cells (res 7) by hour of day (IST), built from completed trips.
/// Learned travel speed between two H3 cells of the same resolution (9, 8 and 7; ETAs use the finest with enough trips).
model HexStat {
  fromCell       String
  toCell         String
  /// H3 resolution of both cells.
  res            Int      @default(7)
  /// 0–23, IST.
  hour           Int
  trips          Int
  avgSpeedKmh    Float
  avgDurationMin Float
  updatedAt      DateTime @updatedAt

  @@id([fromCell, toCell, hour])
  @@index([fromCell])
  @@index([res, trips])
}

/// FCM registration token of a phone where a user is signed in (one row per app install).
model DeviceToken {
  token     String   @id
  userId    String
  app       AppKind
  platform  String   @default("android")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, app])
}

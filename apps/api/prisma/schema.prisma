// Rido database schema (PostgreSQL). Money is stored in whole rupees (Int), matching the fare engine.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  PREFER_NOT_TO_SAY
}

enum WorkType {
  RIDES
  DELIVERIES
}

enum VehicleKind {
  BIKE
  AUTO
  CAB
  GOODS_BIKE
  THREE_WHEELER
  MINI_TRUCK
  PICKUP
  TRUCK
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  ON_HOLD
}

enum KycDocType {
  DRIVING_LICENCE
  AADHAAR
  VEHICLE_RC
  INSURANCE
  POLICE_VERIFICATION
}

enum KycStatus {
  NOT_UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum TripKind {
  RIDE
  PARCEL
}

enum TripStatus {
  SEARCHING
  NO_DRIVERS
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  IN_PROGRESS
  PICKED_UP
  COMPLETED
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
}

enum ParcelPayer {
  SENDER
  RECEIVER
}

enum PlanPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id                String             @id @default(cuid())
  phone             String             @unique
  name              String?
  email             String?
  gender            Gender?
  role              Role               @default(PASSENGER)
  preferWomenDriver Boolean            @default(false)
  autoShareTrips    Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  driver            Driver?
  emergencyContacts EmergencyContact[]
  savedPlaces       SavedPlace[]
  trips             Trip[]             @relation("PassengerTrips")
  tickets           SupportTicket[]
}

model EmergencyContact {
  id       String @id @default(cuid())
  userId   String
  name     String
  relation String
  phone    String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPlace {
  id      String @id @default(cuid())
  userId  String
  label   String
  kind    String @default("other") // home | work | other
  name    String
  address String
  lat     Float
  lng     Float
  note    String?
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Known places for search and reverse geocoding (seeded with Coimbatore landmarks).
model Place {
  id      String @id
  name    String
  address String
  lat     Float
  lng     Float

  @@index([name])
}

model Driver {
  id            String         @id @default(cuid())
  userId        String         @unique
  workType      WorkType       @default(RIDES)
  vehicleKind   VehicleKind
  vehicleModel  String
  vehicleColor  String         @default("")
  plate         String         @unique
  upiId         String
  rating        Float          @default(5)
  ridesCount    Int            @default(0)
  status        DriverStatus   @default(PENDING)
  isOnline      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     KycDocument[]
  trips         Trip[]
  subscriptions Subscription[]
}

model KycDocument {
  id           String     @id @default(cuid())
  driverId     String
  type         KycDocType
  status       KycStatus  @default(NOT_UPLOADED)
  rejectReason String?
  fileUrl      String?
  updatedAt    DateTime   @updatedAt
  driver       Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
}

model Trip {
  id           String       @id @default(cuid())
  kind         TripKind
  status       TripStatus   @default(SEARCHING)
  passengerId  String
  driverId     String?
  vehicleKind  VehicleKind
  pickupName   String
  pickupAddr   String
  pickupLat    Float
  pickupLng    Float
  dropName     String
  dropAddr     String
  dropLat      Float
  dropLng      Float
  distanceKm   Float
  durationMin  Int
  /// Itemised quote: base, distance, time, topUp, subtotal, multiplier, peak, total.
  fare         Json
  fareTotal    Int
  otp          String
  paymentMode  PaymentMode  @default(CASH)
  /// Parcel only: category, weight band, sender/receiver details.
  parcel       Json?
  payer        ParcelPayer?
  rating       Int?
  cancelReason String?
  createdAt    DateTime     @default(now())
  assignedAt   DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  passenger    User         @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver       Driver?      @relation(fields: [driverId], references: [id])
  tickets      SupportTicket[]

  @@index([passengerId, createdAt])
  @@index([driverId, createdAt])
  @@index([status])
}

/// Price list: one row per vehicle and period (daily / weekly / monthly).
model Plan {
  id            String         @id @default(cuid())
  vehicleKind   VehicleKind
  period        PlanPeriod
  price         Int
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@unique([vehicleKind, period])
}

model Subscription {
  id        String             @id @default(cuid())
  driverId  String
  planId    String
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  upiApp    String?
  autopay   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  driver    Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  payments  Payment[]

  @@index([driverId, status])
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Int
  status         PaymentStatus @default(PENDING)
  provider       String        @default("upi-autopay")
  providerRef    String?
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String
  tripId      String?
  topic       String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip?        @relation(fields: [tripId], references: [id])

  @@index([userId])
}

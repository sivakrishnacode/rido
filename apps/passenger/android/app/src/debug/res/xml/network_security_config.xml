<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (overrides src/main): plain HTTP is allowed so the app can reach a local API
     (10.0.2.2 from the emulator, or the PC's LAN IP from a phone). Release builds use src/main: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except the staging API (plain HTTP until it has a domain + TLS). Remove the
     domain-config once the API moves to HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">65.0.233.253</domain>
    </domain-config>
</network-security-config>
